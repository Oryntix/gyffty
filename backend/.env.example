# ---- Application ----
PROJECT_NAME="Gyffty Hampers API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ----
# Dev default is SQLite; swap for Postgres in staging/prod.
DATABASE_URL=sqlite:///./gyffty.db
# DATABASE_URL=postgresql+psycopg://gyffty:gyffty@localhost:5432/gyffty

# ---- CORS ----
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Commerce ----
CURRENCY=INR
FREE_SHIPPING_THRESHOLD=1999
DEFAULT_SHIPPING_FEE=99
TAX_RATE=0.18
