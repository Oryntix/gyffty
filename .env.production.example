# Copy to .env, fill in, and keep out of version control.
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# ---- Domains -------------------------------------------------------------
SITE_DOMAIN=gyffty.com
API_DOMAIN=api.gyffty.com
NEXT_PUBLIC_SITE_URL=https://gyffty.com
NEXT_PUBLIC_API_BASE_URL=https://api.gyffty.com/api/v1

# ---- Secrets -------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_USER=gyffty
POSTGRES_PASSWORD=
POSTGRES_DB=gyffty

# ---- API -----------------------------------------------------------------
BACKEND_CORS_ORIGINS=https://gyffty.com,https://www.gyffty.com
ALLOWED_HOSTS=api.gyffty.com
API_WORKERS=4
LOG_LEVEL=INFO
# Keep the OpenAPI schema private in production.
ENABLE_DOCS=false

# ---- Payments ------------------------------------------------------------
# "mock" lets the whole flow run without a merchant account.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email ---------------------------------------------------------------
# "console" logs receipts instead of sending them.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Gyffty <care@gyffty.com>

# ---- Observability -------------------------------------------------------
SENTRY_DSN=
